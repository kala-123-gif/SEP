# MongoDB Community Server or MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=skill_exchange
JWT_SECRET=skill_exchange_super_secret_2026_change_this
PORT=3000
CLIENT_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000

# Optional SMTP settings for password reset email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional Google OAuth (Google Cloud Console Web OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
VITE_GOOGLE_AUTH_ENABLED=false
